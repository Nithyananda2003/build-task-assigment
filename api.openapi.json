{
  "openapi":"3.1.0",
  "info":{"title":"Daily Spark API","version":"1.0.0","description":"Browser-scoped demo points. No real-money value. All daily boundaries use Asia/Kolkata. Solutions are returned only after completion."},
  "servers":[{"url":"http://127.0.0.1:4173","description":"Local development"}],
  "paths":{
    "/api/health":{"get":{"summary":"Worker liveness (not database readiness)","responses":{"200":{"description":"Worker responds","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"const":true}}}}}}}}},
    "/api/state":{"get":{"summary":"Read current challenge and browser-owned progress","description":"Creates a random HttpOnly SameSite=Strict cookie for new browsers. API responses are never cached. Returns solutions only if this browser has completed today's challenge.","responses":{"200":{"description":"Current state; Set-Cookie may establish a browser session","content":{"application/json":{"schema":{"$ref":"#/components/schemas/State"}}}},"503":{"$ref":"#/components/responses/Error"}}}},
    "/api/complete":{"post":{"summary":"Submit the first and only rewarded daily attempt","description":"Requires the session cookie from GET /api/state, a matching Origin header and application/json. Ignores client score fields. Returns the original result on replay, with alreadyClaimed=true. Database uniqueness prevents duplicate awards.","security":[{"session":[]}],"parameters":[{"in":"header","name":"Origin","required":true,"schema":{"type":"string"},"description":"Must exactly match the request origin."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["day","answers"],"properties":{"day":{"type":"string","format":"date","description":"The current day returned by /api/state."},"answers":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"integer","minimum":0,"maximum":2},"description":"Zero-based choice indices for the three words, in order."}}},"example":{"day":"2026-11-12","answers":[0,1,2]}}}},"responses":{"200":{"description":"Saved progress, authoritative completion and alreadyClaimed flag","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/State"},{"type":"object","required":["alreadyClaimed"],"properties":{"alreadyClaimed":{"type":"boolean"}}}]}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"409":{"description":"Day changed. Reload /api/state before starting a new challenge.","content":{"application/json":{"example":{"error":"A new day has started. Reload to try the new challenge.","code":"DAY_CHANGED"}}}},"413":{"$ref":"#/components/responses/Error"},"415":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}}
  },
  "components":{
    "securitySchemes":{"session":{"type":"apiKey","in":"cookie","name":"spark_session"}},
    "responses":{"Error":{"description":"Recoverable error. Retry writes safely; errors do not prove that a completion was not committed.","content":{"application/json":{"schema":{"type":"object","required":["error"],"properties":{"error":{"type":"string"},"code":{"type":"string"}}}}}}},
    "schemas":{
      "Question":{"type":"object","required":["word","choices"],"additionalProperties":false,"properties":{"word":{"type":"string"},"choices":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"string"}}}},
      "Review":{"type":"object","required":["word","choices","meaning","example","answer"],"properties":{"word":{"type":"string"},"choices":{"type":"array","items":{"type":"string"}},"meaning":{"type":"string"},"example":{"type":"string"},"answer":{"type":"integer","minimum":0,"maximum":2}}},
      "Entry":{"type":"object","required":["day","points","correct","created_at"],"properties":{"day":{"type":"string","format":"date"},"points":{"type":"integer","minimum":10,"maximum":25},"correct":{"type":"integer","minimum":0,"maximum":3},"created_at":{"type":"string","format":"date-time"}}},
      "State":{"type":"object","required":["today","resetsAt","serverNow","timezone","points","level","toNextLevel","levelProgress","streak","completedDays","badges","completion","history","challenge"],"properties":{"today":{"type":"string","format":"date"},"resetsAt":{"type":"string","format":"date-time"},"serverNow":{"type":"string","format":"date-time"},"timezone":{"const":"Asia/Kolkata"},"points":{"type":"integer","minimum":0},"level":{"type":"integer","minimum":1},"toNextLevel":{"type":"integer","minimum":1,"maximum":100},"levelProgress":{"type":"integer","minimum":0,"maximum":99},"streak":{"type":"integer","minimum":0},"completedDays":{"type":"integer","minimum":0},"badges":{"type":"array","items":{"type":"object","required":["id","name","detail","earned","icon"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"detail":{"type":"string"},"earned":{"type":"boolean"},"icon":{"type":"string"}}}},"completion":{"oneOf":[{"type":"null"},{"allOf":[{"$ref":"#/components/schemas/Entry"},{"type":"object","required":["answers","review"],"properties":{"answers":{"type":"array","items":{"type":"integer"}},"review":{"type":"array","items":{"$ref":"#/components/schemas/Review"}}}}]}]},"history":{"type":"array","items":{"$ref":"#/components/schemas/Entry"}},"challenge":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/components/schemas/Question"}}}}
    }
  }
}
